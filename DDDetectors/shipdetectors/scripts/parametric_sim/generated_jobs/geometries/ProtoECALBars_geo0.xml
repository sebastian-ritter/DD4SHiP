<detectors>
  <detector id=0 name="SplitCalTest_Base_and_wide_bars" type="DD4hep_SplitCalWideBars_and_Basis" reflect="true" readout="SplitCalWideBarHits" vis="SplitCalVis" calorimeterType="EM" layer_codes="74777777177777477777727777747777771777774777777287777747777771777774777777277777477777717777747777772777774" hpln_fibre_layers="0">
    <comment>SplitCal test</comment>
    <box x="56*cm" y="56*cm" z="1.2*m" repeat="1" vis="Debugbox" >
    </box>      
    <!-- Wide bar configuration:
         x_offset/y_offset: Global offset (used if x_offsets not specified)
         x_offsets: Per-layer x offsets (comma-separated, one per layer in layer_codes)
                    Supports positive and negative values with units, e.g.: "0*cm, 0.5*cm, -0.5*cm, 0*cm, ..."
         z_spacings: Per-layer z spacing AFTER each layer (comma-separated)
                     If not specified, uses extrazgap only for passive layers (code 7)
    -->
    <widebar x="6*cm" y="36*cm" z="1*cm" num_x="6" x_extra_spacing="0*cm" z_spacing="2.56*cm" extrazgap="0.5*cm" x_offset="0*cm" y_offset="0*cm" vis="SplitCalWideSensitiveVis"  x_offsets="0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm" z_spacings="0.5*cm,0*cm,0.5*cm,0*cm,0.5*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm">
      <material name = "PVT" sensitive = "true">
      </material>
    </widebar>       
    <!-- Thin bar configuration (same parameters as widebar):
         x_offset/y_offset: Global offset (used if x_offsets not specified)  
         x_offsets: Per-layer x offsets (comma-separated, one per layer in layer_codes)
         z_spacings: Per-layer z spacing AFTER each layer
    -->
    <thinbar x="1*cm" y="2.16*m" z="1*cm" num_x="216" x_extra_spacing="0*cm" z_spacing="2.56*cm" extrazgap="0.5*cm" vis="SplitCalThinSensitiveVis" x_offsets="-4*cm,-3*cm,-2*cm,-1*cm,0*cm,1*cm,2*cm,3*cm,4*cm" z_spacings="0.3*cm,0.4*cm,0.5*cm,0.6*cm,0*cm,0*cm,0*cm,0*cm,0.2*cm">
      <material name = "PVT" sensitive = "true">
      </material>
    </thinbar>       
    <hplbox x="2.16*m" y="2.16*m" z="1*cm" extrazgap="0*cm" vis="SplitCalHPLVis">
      <material name = "Aluminium" sensitive = "false">
      </material>
    </hplbox>       
    <hplfibre rmax="0.6*mm" y="2.16*m" z="3.6*mm" thickness="0.1*mm" extrazgap="0*cm" vis="SplitCalHPLVis">
      <material name = "Polysterene" sensitive = "false">
      </material>
    </hplfibre>       
    <hplcore rmax="0.6*mm" y="2.16*m" z="3.6*mm" thickness="0.1*mm" extrazgap="0*cm" vis="SplitCalHPLVis">
      <material name = "Polysterene" sensitive = "true">
      </material>
    </hplcore>       
    <passive_layer x="56*cm" y="56*cm" z="0.4*cm" vis="SplitCalPassiveVis" >
      <material name = "IronPlate" sensitive = "false">
      </material>
    </passive_layer>       
    <split x="56*cm" y="56*cm" z="20*cm" vis="InvisibleWithDaughters" >
      <material name = "Air" sensitive = "false">
      </material>
    </split>       
    <position x="0*cm" y="0*cm" z="0">
    </position>
    <rotation x="0" y="0" z="0">
    </rotation>
  </detector>
  <detector id=1 name="SplitCalTest_Thin" type="DD4hep_SplitCalThinBars" reflect="true" readout="SplitCalThinBarHits" vis="SplitCalVis" calorimeterType="EM" layer_codes="74777777177777477777727777747777771777774777777287777747777771777774777777277777477777717777747777772777774" hpln_fibre_layers="3">
    <comment>SplitCal test</comment>
    <box x="56*cm" y="56*cm" z="1.2*m" repeat="1" vis="Debugbox" >
    </box>      
    <widebar x="6*cm" y="2.16*m" z="1*cm" num_x="36" x_extra_spacing="0*cm" z_spacing="2.56*cm" extrazgap="0.5*cm" vis="SplitCalWideSensitiveVis"  x_offsets="0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm" z_spacings="0.5*cm,0*cm,0.5*cm,0*cm,0.5*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm,0*cm">
      <material name = "PVT" sensitive = "true">
      </material>
    </widebar>       
    <!-- Thin bar configuration with per-layer offset support:
         x_offsets: Per-layer x offsets (comma-separated, one per layer in layer_codes)
                    Example: x_offsets="0*cm, 0*cm, 0.5*cm, -0.5*cm, 0*cm, ..." 
         z_spacings: Per-layer z spacing AFTER each layer
    -->
    <thinbar x="1*cm" y="20*cm" z="1*cm" num_x="20" x_extra_spacing="0*cm" z_spacing="2.56*cm" extrazgap="0.5*cm" x_offset="0*cm" y_offset="0*cm" vis="SplitCalThinSensitiveVis" x_offsets="-4*cm,-3*cm,-2*cm,-1*cm,0*cm,1*cm,2*cm,3*cm,4*cm" z_spacings="0.3*cm,0.4*cm,0.5*cm,0.6*cm,0*cm,0*cm,0*cm,0*cm,0.2*cm">
      <material name = "PVT" sensitive = "true">
      </material>
    </thinbar>       
    <hplbox x="2.16*m" y="2.16*m" z="1*cm" extrazgap="0*cm" vis="SplitCalHPLVis">
      <material name = "Aluminium" sensitive = "false">
      </material>
    </hplbox>       
    <hplfibre rmax="0.6*mm" y="2.16*m" z="3.6*mm" thickness="0.1*mm" extrazgap="0*cm" vis="SplitCalHPLVis">
      <material name = "Polysterene" sensitive = "false">
      </material>
    </hplfibre>       
    <hplcore rmax="0.6*mm" y="2.16*m" z="3.6*mm" thickness="0.1*mm" extrazgap="0*cm" vis="SplitCalHPLVis">
      <material name = "Polysterene" sensitive = "true">
      </material>
    </hplcore>       
    <passive_layer x="2.16*m" y="2.16*m" z="0.4*cm" vis="SplitCalPassiveVis" >
      <material name = "IronPlate" sensitive = "false">
      </material>
    </passive_layer>       
    <split x="2.16*m" y="2.16*m" z="20*cm" vis="InvisibleWithDaughters" >
      <material name = "Air" sensitive = "false">
      </material>
    </split>       
    <position x="0*cm" y="0*cm" z="0">
    </position>
    <rotation x="0" y="0" z="0">
    </rotation>
  </detector>
</detectors>

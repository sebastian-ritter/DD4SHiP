<!-- ====================================================================== -->
<!--                                                                        -->
<!--    XML description of the complete SiD tracker detector                -->
<!--    of the SiD linear collider detector design.                         -->
<!--                                                                        -->
<!--    Contained are the required                                          -->
<!--      ++ global constants used uniquely by this module                  -->
<!--      ++ visualization attributes                                       -->
<!--      ++ the definition of the readout structure and the                -->
<!--         readout segmentation (if necessary)                            -->
<!--      ++ the include statements for the sensitive detectors and         -->
<!--         the corresponding support structure(s)                         -->
<!--                                                                        -->
<!--                                                                        -->
<!--   @author  M.Frank                                                     -->
<!--   @date    14/11/2014                                                  -->
<!--   @modified by S.Ritter on 17.1.2025                                   -->
<!--                                                                        -->
<!-- ====================================================================== -->

<lccdd>
  <!--  Definition of global dictionary constants          -->
  <define>
    <!-- 
      REQUIRED: Set these environment variables BEFORE running ddsim:
      
      export WIDE_X_OFFSETS="-6*cm, -6*cm, 0*cm, 0*cm, 0*cm, 0*cm, 6*cm, 6*cm"
      export THIN_X_OFFSETS="-4*cm, -3*cm, -2*cm, -1*cm, 0*cm, 1*cm, 2*cm, 3*cm, 4*cm"
      
      For no offsets (default behavior), use:
      export WIDE_X_OFFSETS="0*cm, 0*cm, 0*cm, 0*cm, 0*cm, 0*cm, 0*cm, 0*cm, 0*cm"
      export THIN_X_OFFSETS="0*cm, 0*cm, 0*cm, 0*cm, 0*cm, 0*cm, 0*cm, 0*cm, 0*cm"
      
      NOTE: DD4hep does NOT support default values - variables MUST be set!
    -->
  </define>

  <!--  Definition of the used visualization attributes (defined in parent Caloprototype.xml)    -->

  <!--  Definition of the readout segmentation/definition  -->
  <readouts>
    <readout name="SplitCalWideBarHits">
      <!-- Use NoSegmentation so bar/layer IDs are preserved without virtual grid cells -->
      <segmentation type="NoSegmentation"/>
      <id>system:8,splitcal_wide_bar:6,splitcal_wide_layer:6</id>
    </readout>        
    <readout name="SplitCalThinBarHits">
      <!-- Use NoSegmentation so bar/layer IDs are preserved without virtual grid cells -->
      <segmentation type="NoSegmentation"/>
      <id>system:8,splitcal_thin_bar:8,splitcal_thin_layer:8</id>
    </readout>        
<readout name="SplitCalHPLHits">
      <segmentation type="CartesianGridXY" grid_size_x="0.1*mm" grid_size_y="0.1*mm" offset_x="-108*cm" offset_y="-108*cm"/>
    <id>system:8,splitcal_hplx_layer:4,splitcal_hply_layer:4,splitcal_hplfibre:12,x:16,y:16</id>
    </readout>        
  </readouts>

  <!--  Includes for sensitives and support                -->
  <include ref="ProtoECALBars.xml"/>
<!--
-->
</lccdd>
